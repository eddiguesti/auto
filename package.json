{
  "name": "easy-memoir",
  "version": "1.0.0",
  "type": "module",
  "description": "Easy Memoir - Your life story, beautifully told",
  "workspaces": [
    "apps/web",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node services/api/index.js",
    "client": "cd apps/web && npm run dev",
    "build": "cd apps/web && npm run build && cd ../.. && npm run build:validate",
    "build:validate": "node tools/scripts/validate-build.js",
    "build:cloudflare": "npm run build && node tools/scripts/prepare-cloudflare-assets.js",
    "test:cloudflare": "vitest run --config cloudflare/vitest.config.js",
    "test:cloudflare:api": "node --test --test-concurrency=1 cloudflare/api/native.test.mjs cloudflare/api/auth-native.test.mjs cloudflare/api/account-native.test.mjs cloudflare/api/photos-native.test.mjs cloudflare/ingress-identity.test.mjs",
    "test:cloudflare:readiness": "node --test cloudflare/readiness/preflight.test.mjs",
    "migration:inventory": "node cloudflare/readiness/inventory.mjs --write",
    "migration:preflight": "node cloudflare/readiness/preflight.mjs",
    "lint:cloudflare": "eslint cloudflare/ packages/shared/payment-catalog.js packages/shared/photo-analysis-prompt.js tools/scripts/cloudflare-data.mjs tools/scripts/cloudflare-bound-data.mjs tools/scripts/prepare-cloudflare-assets.js",
    "check:cloudflare:api": "npm run test:cloudflare:api && wrangler deploy --config wrangler.api-staging.jsonc --dry-run --outdir .cloudflare/api-dry-run && wrangler deploy --config cloudflare/wrangler.auth-identity.jsonc --dry-run --outdir ../.cloudflare/identity-dry-run",
    "test:data-migration": "node --test cloudflare/db/data.test.mjs",
    "data:cloudflare": "node tools/scripts/cloudflare-data.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare:web": "npm run build:cloudflare && npm run test:cloudflare && wrangler deploy",
    "start": "node services/api/index.js",
    "install-all": "npm install && cd apps/web && npm install",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix && cd apps/web && npm audit fix",
    "security:check": "npm run audit && npm run lint:security && npm run build:validate",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:coverage": "vitest run --config vitest.config.js --coverage",
    "test:web": "cd apps/web && npm test",
    "test:all": "npm test && npm run test:web",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "migrate": "node-pg-migrate --migrations-dir services/api/db/migrations --migration-file-language js",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create",
    "migrate:status": "node -e \"import('./services/api/db/runner.js').then(m => import('./services/api/db/index.js').then(d => m.migrationStatus(d.default).then(() => process.exit(0))))\"",
    "migrate:status:legacy": "npm run migrate -- up --dry-run",
    "worker": "node services/worker/index.js",
    "dev:worker": "node --watch services/worker/index.js",
    "backup:verify": "node tools/scripts/verify-backup.js",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "eslint services/api/",
    "lint:client": "cd apps/web && eslint src/",
    "format": "prettier --write \"services/api/**/*.js\" \"*.js\" \"apps/web/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"services/api/**/*.js\" \"*.js\" \"apps/web/src/**/*.{js,jsx}\"",
    "backup": "bash tools/scripts/backup-db.sh",
    "prepare": "husky",
    "lint:security": "eslint --config eslint.security.config.js services/api/",
    "test:postgres": "vitest run --config vitest.config.js services/api/tests/*.postgres.test.js services/api/tests/backupRestore.test.js",
    "verify": "npm run lint && npm run lint:security && npm run lint:cloudflare && npm run format:check && npm run test:all && npm run test:cloudflare && npm run test:data-migration && npm run test:cloudflare:readiness && npm run check:cloudflare:api && npm run build:cloudflare"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@sentry/node": "10.76.2",
    "bcryptjs": "^3.0.3",
    "compression": "1.8.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "epub-gen-memory": "^1.1.2",
    "express": "^4.21.0",
    "express-rate-limit": "8.7.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "ioredis": "5.9.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.5.0",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "8.0.4",
    "openai": "7.47.0",
    "pdf-lib": "1.17.1",
    "pg": "^8.17.2",
    "pg-boss": "12.15.0",
    "replicate": "^1.4.0",
    "stripe": "^20.3.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.59.1",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "espree": "10.4.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "^3.0.0",
    "vitest": "4.1.12",
    "wrangler": "4.156.2",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-no-secrets": "2.2.1"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "body-parser": "^1.20.9",
    "undici": "^7.30.1"
  }
}
