{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "easy-memoir-api-staging",
  "account_id": "df3d63daad6e36a66171d8ae6b368da7",
  "main": "cloudflare/api-staging.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  // Bcrypt12 preserves imported credentials and exceeds the Free CPU budget.
  // Verify a Paid Workers plan and hosted CPU profiling before enabling auth.
  "limits": { "cpu_ms": 5000 },
  "vars": {
    "NATIVE_API_STAGE": "local-d1-slice",
    // Deliberate local test policy. Verify actual source Node/pg timezone before cutover.
    "SOURCE_TIMESTAMP_TIMEZONE": "UTC"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easy-memoir-staging-local",
      // Local-only sentinel: replace with a separately provisioned STAGING database before any deployment.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "cloudflare/api/migrations"
    }
  ]
}
