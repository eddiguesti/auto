{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "easy-memoir-web-staging",
  "account_id": "bbdbba416f07c76f4c2754f8a61807f4",
  "main": "web.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../.cloudflare/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": { "APP_URL": "https://easy-memoir-web-staging.easy-memoir.workers.dev" },
  "services": [{ "binding": "API", "service": "easy-memoir-api-staging" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
